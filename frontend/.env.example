# API Configuration
# For local development with separate React (:3000) and API (:5000) servers,
# uncomment and set REACT_APP_API_URL below.
# If not set, the app will auto-detect:
#   - Use http://localhost:5000/api if running on localhost:3000
#   - Use same origin /api otherwise (for Docker/production)
REACT_APP_API_URL=http://localhost:5000/api

# Socket.io URL (for real-time updates)
# For local development if React runs on :3000 and backend on :5000, set:
#   REACT_APP_SOCKET_URL=http://localhost:5000
# If not set, the app will default to the same origin.
REACT_APP_SOCKET_URL=http://localhost:5000
